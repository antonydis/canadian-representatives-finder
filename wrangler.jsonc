{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infocivic",
  "main": "src-worker/index.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/reps", "/triage", "/laval"]
  },
  "observability": { "enabled": true }
}
